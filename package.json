{
  "name": "@youichi/repograph",
  "version": "0.1.2",
  "description": "Export repository code graphs with codebase-memory-mcp.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-youichi/repograph.git"
  },
  "type": "module",
  "bin": {
    "repograph": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "REPOGRAPH_INTEGRATION=1 bun test test/integration.test.ts test/languages.integration.test.ts",
    "test:languages": "REPOGRAPH_INTEGRATION=1 bun test test/languages.integration.test.ts",
    "test:package": "bun run build && node scripts/verify-package.mjs",
    "build": "bun build ./src/cli.ts ./src/index.ts ./src/cbm.ts ./src/callables.ts ./src/classes.ts --target node --outdir dist --external \"*\"",
    "prepack": "bun run build"
  },
  "dependencies": {
    "codebase-memory-mcp": "0.12.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6"
  },
  "trustedDependencies": [
    "codebase-memory-mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
